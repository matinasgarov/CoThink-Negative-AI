# Normalize line endings so Windows checkouts don't produce whole-file diffs.
* text=auto eol=lf

# Binary / generated artifacts git should not try to diff or merge.
*.pdf    binary
*.db     binary
*.joblib binary
*.safetensors binary
*.pt     binary

# Generated build output: collapse in PR diffs, but still versioned.
azerbaijani-toxicity-moderation/lexicon/data/dist/** linguist-generated=true
